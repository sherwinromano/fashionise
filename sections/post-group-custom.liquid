<section
  class="post-group"
  style="
    --post-group-text-color: {{ section.settings.text_color }};
    --post-group-meta-color: {{ section.settings.meta_color }};
    --post-group-padding-top: {{ section.settings.padding_top }}px;
    --post-group-padding-bottom: {{ section.settings.padding_bottom }}px;
    --post-group-column-gap: {{ section.settings.column_gap }}px;
    --post-group-row-gap: {{ section.settings.row_gap }}px;
  "
>
  <div class="post-group__container page-width">
    {% if section.settings.heading != blank %}
      <header class="post-group__header">
        <h2 class="post-group__heading">
          {{ section.settings.heading | escape }}
        </h2>
      </header>
    {% endif %}

    {% if section.settings.blog != blank %}
      {% assign selected_blog = section.settings.blog %}
      {% assign articles = selected_blog.articles | sort: 'created_at' %}

      <div class="post-group__grid">
        {% for article in articles limit: section.settings.articles_to_show %}
          <article class="post-group__card">
            {% if article.image %}
              <a
                href="{{ article.url }}"
                class="post-group__image-link"
                aria-label="{{ article.title | escape }}"
              >
                <div class="post-group__image-wrapper">
                  {{
                    article.image
                    | image_url: width: 1200
                    | image_tag:
                      class: 'post-group__image',
                      loading: 'lazy',
                      widths: '480, 640, 800, 1000, 1200',
                      sizes: '(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw',
                      alt: article.image.alt
                    | default: article.title
                    | escape
                  }}
                </div>
              </a>

            {% else %}
              <a
                href="{{ article.url }}"
                class="post-group__image-link"
                aria-label="{{ article.title | escape }}"
              >
                <div class="post-group__image-wrapper post-group__image-wrapper--placeholder">
                  {{ 'image' | placeholder_svg_tag: 'post-group__placeholder' }}
                </div>
              </a>
            {% endif %}
            <div class="post-group__content">
              {% if selected_blog.title != blank %}
                <div class="post-group__category">Fashion</div>
              {% endif %}

              {% if article.title != blank %}
                <a
                  href="{{ article.url }}"
                  role="heading"
                  class="post-group__article-link"
                >
                  {{ article.title | escape }}
                </a>
              {% endif %}

              <a class="post-group__meta" href="{{ article.url }}" style="text-decoration: none;">
                {% if section.settings.show_date and article.published_at %}
                  <time
                    class="post-group__date"
                    datetime="{{ article.published_at | date: '%Y-%m-%d' }}"
                  >
                    {{ article.published_at | date: '%b %d, %Y' }}
                  </time>
                {% endif %}

                {% if section.settings.show_date and section.settings.show_author and article.author != blank %}
                  <span class="post-group__meta-separator"> | </span>
                {% endif %}

                {% if section.settings.show_author and article.author != blank %}
                  <span class="post-group__author">
                    BY <strong>{{ article.author | escape }}</strong>
                  </span>
                {% endif %}

                <div
                  href="{{ article.url }}"
                  class="post-group__article-icon"
                  aria-label="Read {{ article.title | escape }}"
                >
                  <svg
                    width="12"
                    height="12"
                    viewBox="0 0 12 12"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    aria-hidden="true"
                  >
                    <path
                      d="M3.5 8.5L8.5 3.5"
                      stroke="currentColor"
                      stroke-width="1"
                      stroke-linecap="round"
                    />
                    <path
                      d="M4.5 3.5H8.5V7.5"
                      stroke="currentColor"
                      stroke-width="1"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </div>
              </a>
            </div>
          </article>

        {% else %}
          <div class="post-group__empty">
            <p>No articles are available in this blog.</p>
          </div>
        {% endfor %}
      </div>

    {% else %}
      <div class="post-group__empty">
        <p>Select a blog in the Theme Editor.</p>
      </div>
    {% endif %}
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .post-group {
    width: 100%;
    color: var(--post-group-text-color);
    padding-top: var(--post-group-padding-top);
    padding-bottom: var(--post-group-padding-bottom);
  }

  #shopify-section-{{ section.id }} .post-group__container {
    width: 100%;
  }

  #shopify-section-{{ section.id }} .post-group__header {
    margin: 0 0 3rem;
  }

  #shopify-section-{{ section.id }} .post-group__heading {
    margin: 0;
    color: var(--post-group-text-color);
    font-size: calc(1.8rem + .3vw) !important;
    font-weight: 600;
    line-height: 1.2;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .post-group__grid {
    display: grid;
    grid-template-columns: 1fr;
    column-gap: var(--post-group-column-gap);
    row-gap: var(--post-group-row-gap);
  }

  #shopify-section-{{ section.id }} .post-group__card {
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .post-group__image-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .post-group__image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: #f2f2f2;
  }


  #shopify-section-{{ section.id }} .post-group__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }


  #shopify-section-{{ section.id }}
    .post-group__image-link:hover
    .post-group__image {
    transform: scale(1.025);
  }

  #shopify-section-{{ section.id }} .post-group__placeholder {
    display: block;
    width: 100%;
    height: 100%;
  }


  #shopify-section-{{ section.id }} .post-group__content {
    padding-top: 1.3rem;
  }

  #shopify-section-{{ section.id }} .post-group__category {
    margin-bottom: 0.75rem;
    color: var(--post-group-meta-color);
    font-size: 13px;
    line-height: 1.3;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .post-group__article-link {
    color: var(--post-group-text-color);
    font-size: calc(1.8rem + .6vw) !important;
    font-family: var(--font-heading-family);
    line-height: 1.05;
    text-decoration: none;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;

  }

  #shopify-section-{{ section.id }} .post-group__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 1rem;
    color: #6c757d;
    font-size: 12px;
    line-height: 1.4;
    text-transform: uppercase;
  }


  #shopify-section-{{ section.id }} .post-group__meta-separator {
    opacity: 0.7;
  }

  #shopify-section-{{ section.id }} .post-group__author {
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .post-group__article-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    margin-left: 0.1rem;
    color: currentColor;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  #shopify-section-{{ section.id }} .post-group__article-icon:hover {
    opacity: 0.6;
  }

  #shopify-section-{{ section.id }} .post-group__article-icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .post-group__empty {
    padding: 3rem 0;
    color: var(--post-group-meta-color);
    font-size: 0.875rem;
    text-align: center;
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .post-group__header {
      margin-bottom: 3.5rem;
    }

    #shopify-section-{{ section.id }} .post-group__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 1024px) {
    #shopify-section-{{ section.id }} .post-group__header {
      margin-bottom: 3.75rem;
    }

    #shopify-section-{{ section.id }} .post-group__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .post-group__image {
      transition: none;
    }

    #shopify-section-{{ section.id }} .post-group__article-link {
      transition: none;
    }

    #shopify-section-{{ section.id }} .post-group__article-icon {
      transition: none;
    }
  }
</style>

{% schema %}
{
  "name": "Post group",
  "tag": "section",
  "class": "section-post-group",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "LATEST POSTS"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "articles_to_show",
      "label": "Articles to show",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 6
    },

    {
      "type": "header",
      "content": "Article information"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show published date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": true
    },

    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 12,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Row gap",
      "min": 24,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 56
    },

    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "meta_color",
      "label": "Metadata",
      "default": "#977A50"
    },

    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 32,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 32,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "Post group",
      "category": "Custom sections"
    }
  ]
}
{% endschema %}
