{%- liquid
  assign section_id = section.id
  assign heading = section.settings.heading
  assign heading_color = section.settings.heading_color
  assign background_color = section.settings.background_color
  assign text_color = section.settings.text_color
  assign accent_color = section.settings.accent_color
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
-%}

<section
  id="TopVideos-{{ section_id }}"
  class="top-videos"
  data-section-id="{{ section_id }}"
  data-section-type="top-videos"
  aria-label="{{ heading | default: 'Top Videos' | escape }}"
>
  {%- style -%}
    #TopVideos-{{ section_id }} {
      --top-videos-heading-color: {{ heading_color }};
      --top-videos-bg-color: {{ background_color }};
      --top-videos-text-color: {{ text_color }};
      --top-videos-accent-color: {{ accent_color }};
      --top-videos-padding-top: {{ padding_top }}px;
      --top-videos-padding-bottom: {{ padding_bottom }}px;
    }
  {%- endstyle -%}

  <div class="top-videos__container page-width">
    {%- if heading != blank -%}
      <h2 class="top-videos__heading">{{ heading }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="top-videos__carousel">
        {%- if section.blocks.size > 1 -%}
          <button
            type="button"
            class="top-videos__nav top-videos__nav--prev"
            data-top-videos-prev
            aria-label="Previous video"
          >
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M7.68473 7.33186C8.07526 6.94134 8.07526 6.30817 7.68473 5.91765C7.29421 5.52712 6.66105 5.52712 6.27052 5.91765L1.60492 10.5832C0.823873 11.3643 0.823872 12.6306 1.60492 13.4117L6.27336 18.0801C6.66388 18.4706 7.29705 18.4706 7.68757 18.0801C8.0781 17.6896 8.0781 17.0564 7.68757 16.6659L4.02154 12.9998L22 12.9998C22.5523 12.9998 23 12.5521 23 11.9998C23 11.4476 22.5523 10.9998 22 10.9998L4.01675 10.9998L7.68473 7.33186Z" fill="#fff"></path> </g>
            </svg>
          </button>
        {%- endif -%}

        <div class="top-videos__viewport" data-top-videos-viewport>
          <div class="top-videos__track" data-top-videos-track tabindex="-1">
            {%- for block in section.blocks -%}
              {%- assign block_heading = block.settings.heading -%}
              {%- assign block_text = block.settings.text -%}
              {%- assign block_thumb = block.settings.thumbnail -%}
              {%- assign block_video_url = block.settings.video_url -%}
              {%- assign block_video_href = blank -%}

              {%- if block_video_url != blank -%}
                {%- case block_video_url.type -%}
                  {%- when 'youtube' -%}
                    {%- assign block_video_href = 'https://www.youtube.com/watch?v=' | append: block_video_url.id -%}
                  {%- when 'vimeo' -%}
                    {%- assign block_video_href = 'https://vimeo.com/' | append: block_video_url.id -%}
                {%- endcase -%}
              {%- endif -%}

              <div class="top-videos__slide" {{ block.shopify_attributes }}>
                <div class="top-videos__media">
                  {%- if block_thumb != blank -%}
                    {{
                      block_thumb
                      | image_url: width: 900
                      | image_tag: loading: 'lazy', class: 'top-videos__thumbnail', alt: block_heading
                      | default: 'Video thumbnail', widths: '400,600,900', draggable: false
                    }}
                  {%- else -%}
                    {{
                      'lifestyle-1'
                      | placeholder_svg_tag: 'top-videos__thumbnail top-videos__thumbnail--placeholder'
                    }}
                  {%- endif -%}

                  {%- if block_video_href != blank -%}
                    <a
                      href="{{ block_video_href | escape }}"
                      class="top-videos__play-btn"
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label="Play video: {{ block_heading | default: 'video' | escape }}"
                    >
                      <svg class="top-videos__play-icon" viewBox="0 0 48 48" fill="none" aria-hidden="true">
                        <circle cx="24" cy="24" r="22" stroke="currentColor" stroke-width="1.5"/>
                        <path d="M19 15l16 9-16 9V15z" fill="currentColor"/>
                      </svg>
                    </a>
                  {%- endif -%}
                </div>
                <div style="padding: 1.5rem !important;">
                  {%- if block_heading != blank -%}
                    <h3 class="top-videos__slide-heading">{{ block_heading }}</h3>
                  {%- endif -%}

                  {%- if block_text != blank -%}
                    <div class="top-videos__slide-text">{{ block_text }}</div>
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>

        {%- if section.blocks.size > 1 -%}
          <button
            type="button"
            class="top-videos__nav top-videos__nav--next"
            data-top-videos-next
            aria-label="Next video"
          >
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="#000000">
              <g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <title></title> <g id="Complete"> <g id="arrow-right"> <g> <polyline data-name="Right" fill="none" id="Right-2" points="16.4 7 21.5 12 16.4 17" stroke="#fff" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></polyline> <line fill="none" stroke="#fff" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" x1="2.5" x2="19.2" y1="12" y2="12"></line> </g> </g> </g> </g>
            </svg>
          </button>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 1 -%}
        <div class="top-videos__dots" data-top-videos-dots role="tablist" aria-label="Video slides"></div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

<style>
  .top-videos {
    background-color: var(--top-videos-bg-color, #191919);
    padding-top: var(--top-videos-padding-top, 60px);
    padding-bottom: var(--top-videos-padding-bottom, 60px);
    overflow: hidden;
  }

  .top-videos__container {
    max-width: 1200px;
    margin: 0 auto;
    padding-left: 20px;
    padding-right: 20px;
  }

  .top-videos__heading {
    color: var(--top-videos-heading-color, #f5f5f5);
    font-size: calc(1.325rem + 0.9vw) !important;
    font-weight: 600;
    margin: 0 0 24px;
    line-height: 1.2;
  }

  .top-videos__carousel {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* Viewport clips the track; track is moved with transform: translateX() */
  .top-videos__viewport {
    flex: 1 1 auto;
    overflow: hidden;
    padding: 4px 4px 8px;
  }

  /* Track: mobile-first, 1 slide per view */
  .top-videos__track {
    display: flex;
    gap: 20px;
    margin: 0;
    list-style: none;
    transform: translateX(0);
    transition: transform 0.4s cubic-bezier(0.25, 0.1, 0.25, 1);
    will-change: transform;
    touch-action: pan-y;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }

  .top-videos__track.is-dragging {
    transition: none;
    cursor: grabbing;
  }

  .top-videos__slide {
    flex: 0 0 100%;
    max-width: 100%;
    display: flex;
    flex-direction: column;
  }

  .top-videos__slide img {
    pointer-events: none;
  }

  .top-videos__media {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 4px;
    background-color: #000;
  }

  .top-videos__thumbnail {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .top-videos__thumbnail--placeholder {
    width: 100%;
    height: 100%;
  }

  .top-videos__video-frame {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .top-videos__play-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: transparent;
    border: none;
    padding: 0;
    color: var(--top-videos-accent-color, #ffffff);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease;
  }

  .top-videos__play-btn:hover,
  .top-videos__play-btn:focus-visible {
    transform: translate(-50%, -50%) scale(1.08);
  }

  .top-videos__play-icon {
    width: 100%;
    height: 100%;
  }

  .top-videos__slide-heading {
    color: var(--top-videos-heading-color, #f5f5f5);
    font-size: calc(1.425rem + 2.1vw) !important;
    font-weight: 600;
    line-height: 1.3;
    margin: 16px 0 8px;
  }

  .top-videos__slide-text {
    color: var(--top-videos-text-color, #c9a48c);
    font-size: 14px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    line-height: 1.6;
    margin: 0;
  }

  .top-videos__slide-text p {
    margin: 0;
  }

  .top-videos__nav {
    flex: 0 0 auto;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: none;
    background: transparent;
    color: var(--top-videos-accent-color, #ffffff);
    cursor: pointer;
    display: none;
    align-items: center;
    justify-content: center;
  }

  .top-videos__nav:hover,
  .top-videos__nav:focus-visible {
    opacity: 0.75;
  }

  .top-videos__nav:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .top-videos__nav-icon {
    width: 24px;
    height: 24px;
  }

  .top-videos__dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin-top: 24px;
  }

  .top-videos__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1.5px solid transparent;
    padding: 0;
    background-color: rgba(255, 255, 255, 0.35);
    background-clip: content-box;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .top-videos__dot--active {
    width: 12px;
    height: 12px;
    padding: 2px;
    border-color: var(--top-videos-accent-color, #ffffff);
    background-color: var(--top-videos-accent-color, #ffffff);
  }

  /* Tablet and up: 2 slides per view, arrows appear */
  @media screen and (min-width: 768px) {
    .top-videos__heading {
      font-size: 1.75rem;
      margin-bottom: 32px;
      margin-left: 5rem;
    }

    .top-videos__slide {
      flex: 0 0 calc(50% - 10px);
      max-width: calc(50% - 10px);
    }

    .top-videos__nav {
      display: flex;
    }

    .top-videos__play-btn {
      width: 64px;
      height: 64px;
    }
  }

  /* Large screens: tighten container, slightly larger type */
  @media screen and (min-width: 1024px) {
    .top-videos__container {
      padding-left: 40px;
      padding-right: 40px;
    }

    .top-videos__heading {
      font-size: 2rem;
    }
  }
</style>

<script>
  (function () {
    function getEmbedUrl(url) {
      if (!url) return null;

      var youtubeMatch = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/)([\w-]{11})/);
      if (youtubeMatch) {
        return 'https://www.youtube.com/embed/' + youtubeMatch[1] + '?autoplay=1&rel=0';
      }

      var vimeoMatch = url.match(/vimeo\.com\/(?:video\/)?(\d+)/);
      if (vimeoMatch) {
        return 'https://player.vimeo.com/video/' + vimeoMatch[1] + '?autoplay=1';
      }

      return null;
    }

    function getSlidesPerView() {
      return window.innerWidth >= 768 ? 2 : 1;
    }

    function getStep(track, slides) {
      if (!slides.length) return 0;
      var slideRect = slides[0].getBoundingClientRect();
      var trackStyle = window.getComputedStyle(track);
      var gap = parseFloat(trackStyle.columnGap || trackStyle.gap || '0') || 0;
      return slideRect.width + gap;
    }

    function debounce(fn, wait) {
      var timeout;
      return function () {
        var args = arguments;
        window.clearTimeout(timeout);
        timeout = window.setTimeout(function () {
          fn.apply(null, args);
        }, wait);
      };
    }

    function initTopVideos(section) {
      if (!section || section.dataset.topVideosInitialized === 'true') return;

      var viewport = section.querySelector('[data-top-videos-viewport]');
      var track = section.querySelector('[data-top-videos-track]');
      var prevBtn = section.querySelector('[data-top-videos-prev]');
      var nextBtn = section.querySelector('[data-top-videos-next]');
      var dotsContainer = section.querySelector('[data-top-videos-dots]');
      var slides = section.querySelectorAll('.top-videos__slide');
      var triggers = section.querySelectorAll('[data-video-trigger]');
      var dots = [];

      if (!viewport || !track || !slides.length) return;

      var totalSlides = slides.length;
      var currentIndex = 0;
      var maxIndex = Math.max(0, totalSlides - getSlidesPerView());
      var isDragging = false;
      var dragStartX = 0;
      var dragStartTranslate = 0;
      var dragDelta = 0;
      var activePointerId = null;
      var suppressNextClick = false;

      function renderDots() {
        if (!dotsContainer) return;
        dotsContainer.innerHTML = '';
        dots = [];

        for (var i = 0; i <= maxIndex; i++) {
          var dot = document.createElement('button');
          dot.type = 'button';
          dot.className = 'top-videos__dot';
          dot.setAttribute('role', 'tab');
          dot.setAttribute('aria-label', 'Go to slide ' + (i + 1));
          dot.setAttribute('data-dot-index', i);
          dotsContainer.appendChild(dot);
          dots.push(dot);
        }

        dots.forEach(function (dot, i) {
          dot.addEventListener('click', function () {
            goTo(i, true);
          });
        });
      }

      function goTo(index, animate) {
        currentIndex = Math.min(Math.max(index, 0), maxIndex);
        var step = getStep(track, slides);
        track.style.transition = animate === false ? 'none' : '';
        track.style.transform = 'translateX(' + -currentIndex * step + 'px)';

        dots.forEach(function (dot, i) {
          var isActive = i === currentIndex;
          dot.classList.toggle('top-videos__dot--active', isActive);
          dot.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });

        if (prevBtn) prevBtn.disabled = currentIndex <= 0;
        if (nextBtn) nextBtn.disabled = currentIndex >= maxIndex;
      }

      function recalculate() {
        var newMaxIndex = Math.max(0, totalSlides - getSlidesPerView());
        if (newMaxIndex !== maxIndex) {
          maxIndex = newMaxIndex;
          renderDots();
        }
        goTo(Math.min(currentIndex, maxIndex), false);
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', function () {
          goTo(currentIndex - 1, true);
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', function () {
          goTo(currentIndex + 1, true);
        });
      }

      renderDots();

      // --- Drag / swipe support (mouse + touch, via Pointer Events) ---
      function onPointerDown(event) {
        if (event.pointerType === 'mouse' && event.button !== 0) return;
        if (event.target.closest && event.target.closest('.top-videos__play-btn')) return;
        isDragging = true;
        dragDelta = 0;
        dragStartX = event.clientX;
        dragStartTranslate = -currentIndex * getStep(track, slides);
        activePointerId = event.pointerId;
        track.classList.add('is-dragging');
        try {
          track.setPointerCapture(activePointerId);
        } catch (e) {
          /* no-op */
        }
      }

      function onPointerMove(event) {
        if (!isDragging) return;
        dragDelta = event.clientX - dragStartX;
        var step = getStep(track, slides) || 1;
        var min = -(maxIndex * step);
        var max = 0;
        var next = dragStartTranslate + dragDelta;

        // Rubber-band resistance past the first/last slide
        if (next > max) next = max + (next - max) * 0.3;
        if (next < min) next = min + (next - min) * 0.3;

        track.style.transform = 'translateX(' + next + 'px)';
      }

      function onPointerEnd() {
        if (!isDragging) return;
        isDragging = false;
        track.classList.remove('is-dragging');

        if (activePointerId !== null) {
          try {
            track.releasePointerCapture(activePointerId);
          } catch (e) {
            /* no-op */
          }
          activePointerId = null;
        }

        var threshold = 40;
        var nextIndex = currentIndex;
        if (Math.abs(dragDelta) > threshold) {
          nextIndex = dragDelta < 0 ? currentIndex + 1 : currentIndex - 1;
        }

        if (Math.abs(dragDelta) > 5) {
          suppressNextClick = true;
        }

        goTo(nextIndex, true);
      }

      track.addEventListener('pointerdown', onPointerDown);
      track.addEventListener('pointermove', onPointerMove);
      track.addEventListener('pointerup', onPointerEnd);
      track.addEventListener('pointercancel', onPointerEnd);

      // Prevent the click that follows a drag from triggering play/video buttons
      track.addEventListener(
        'click',
        function (event) {
          if (suppressNextClick) {
            event.preventDefault();
            event.stopPropagation();
            suppressNextClick = false;
          }
        },
        true
      );

      triggers.forEach(function (button) {
        button.addEventListener('click', function () {
          var url = button.getAttribute('data-video-url');
          var embedUrl = getEmbedUrl(url);
          if (!embedUrl) return;

          var media = button.closest('.top-videos__media');
          if (!media) return;

          var iframe = document.createElement('iframe');
          iframe.src = embedUrl;
          iframe.className = 'top-videos__video-frame';
          iframe.setAttribute('frameborder', '0');
          iframe.setAttribute('allow', 'autoplay; encrypted-media; picture-in-picture');
          iframe.setAttribute('allowfullscreen', '');
          iframe.setAttribute('title', button.getAttribute('aria-label') || 'Video');

          media.innerHTML = '';
          media.appendChild(iframe);
        });
      });

      window.addEventListener('resize', debounce(recalculate, 150));

      goTo(0, false);
      section.dataset.topVideosInitialized = 'true';
    }

    function initAll(root) {
      var scope = root || document;
      scope.querySelectorAll('[data-section-type="top-videos"]').forEach(initTopVideos);
    }

    document.addEventListener('DOMContentLoaded', function () {
      initAll(document);
    });

    document.addEventListener('shopify:section:load', function (event) {
      var section = event.target.querySelector('[data-section-type="top-videos"]');
      if (section) {
        section.dataset.topVideosInitialized = 'false';
        initTopVideos(section);
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Top Videos",
  "tag": "section",
  "class": "section-top-videos",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Top Videos"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#f5f5f5"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#191919"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Description text color",
      "default": "#c9a48c"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Play button / arrows / dots color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        {
          "type": "image_picker",
          "id": "thumbnail",
          "label": "Thumbnail image"
        },
        {
          "type": "video_url",
          "id": "video_url",
          "label": "Video URL",
          "accept": ["youtube", "vimeo"],
          "info": "Supports YouTube and Vimeo links"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Beautiful Dress Shown By Top Fashion Models"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Description",
          "default": "<p>Vel non nibh vestibulum massa ullamcorper, bibendum ultrices venenatis, id id sed mass commodo eros duis ut cras neque.</p>"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Top Videos",
      "category": "Custom sections",
      "blocks": [{ "type": "video" }, { "type": "video" }]
    }
  ]
}
{% endschema %}
