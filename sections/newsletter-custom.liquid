<section
  id="shopify-section-{{ section.id }}"
  class="newsletter-section"
  style="
    --newsletter-background: {{ section.settings.background_color }};
    --newsletter-text-color: {{ section.settings.text_color }};
    --newsletter-input-background: {{ section.settings.input_background_color }};
    --newsletter-input-border: {{ section.settings.input_border_color }};
    --newsletter-button-background: {{ section.settings.button_background_color }};
    --newsletter-button-text: {{ section.settings.button_text_color }};
    --padding-block: {{ section.settings.padding_block }}px;
  "
>
  <div class="newsletter-section__container page-width">
    <div class="newsletter-section__content">
      {%- if section.settings.heading != blank -%}
        <div class="newsletter-section__heading-wrapper">
          <h2 class="newsletter-section__heading">
            {{ section.settings.heading | escape }}
          </h2>
        </div>
      {%- endif -%}

      {%- if section.settings.show_form -%}
        <div class="newsletter-section__form-wrapper">
          {% form 'customer', class: 'newsletter-section__form' %}
            <input
              type="hidden"
              name="contact[tags]"
              value="newsletter"
            >

            {%- if form.posted_successfully? -%}
              <p
                class="newsletter-section__message newsletter-section__message--success"
                tabindex="-1"
                autofocus
              >
                {{ section.settings.success_message | escape }}
              </p>

            {%- elsif form.errors -%}
              <div
                class="newsletter-section__message newsletter-section__message--error"
                role="alert"
              >
                {{ form.errors | default_errors }}
              </div>
            {%- endif -%}

            <div class="newsletter-section__form-fields">
              <div class="newsletter-section__input-wrapper">
                <label
                  class="visually-hidden"
                  for="NewsletterEmail-{{ section.id }}"
                >
                  {{ section.settings.email_label | escape }}
                </label>

                <input
                  id="NewsletterEmail-{{ section.id }}"
                  type="email"
                  name="contact[email]"
                  class="newsletter-section__input"
                  value="{{ form.email }}"
                  autocomplete="email"
                  autocorrect="off"
                  autocapitalize="off"
                  placeholder="{{ section.settings.placeholder | escape }}"
                  required
                  {% if form.errors %}
                    aria-invalid="true"
                    aria-describedby="NewsletterError-{{ section.id }}"
                  {% endif %}
                >
              </div>

              <button
                type="submit"
                class="newsletter-section__button"
              >
                {{ section.settings.button_text | escape }}
              </button>
            </div>
          {% endform %}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .newsletter-section {
    width: 100%;
    padding-block: var(--padding-block);
    display: flex;
    align-items: center;
    background-color: var(--newsletter-background);
    color: var(--newsletter-text-color);
  }

  #shopify-section-{{ section.id }} .newsletter-section__container {
    width: 100%;
    display: flex;
    justify-content: space-between;
  }

  #shopify-section-{{ section.id }} .newsletter-section__content {
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: 3rem;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .newsletter-section__heading-wrapper {
    width: 100%;
  }

  #shopify-section-{{ section.id }} .newsletter-section__heading {
    max-width: 100%;
    text-align: center;
    margin: 0;

    color: var(--newsletter-text-color);
    font-size: clamp(3.5rem, 6vw, 5rem);
    line-height: 1.05;
    letter-spacing: -0.025em;
  }

  #shopify-section-{{ section.id }} .newsletter-section__form-wrapper {
    width: 100%;
  }

  #shopify-section-{{ section.id }} .newsletter-section__form {
    width: 100%;
    display: flex;
  }

  #shopify-section-{{ section.id }} .newsletter-section__form-fields {
    display: flex;
    flex-direction: column;
    max-width: 100%;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .newsletter-section__input-wrapper {
    flex: 1;
    display: flex;
  }

  #shopify-section-{{ section.id }} .newsletter-section__input {
    display: block;
    width: 100%;
    margin: 0;
    padding: 1.50rem;
    border: 1px solid var(--newsletter-input-border);
    border-radius: 0;
    background-color: var(--newsletter-input-background);
    color: var(--newsletter-text-color);
    font-family: inherit;
    font-size: 1.35rem;
    box-shadow: none;
    outline: none;
    appearance: none;
  }

  #shopify-section-{{ section.id }} .newsletter-section__input::placeholder {
    color: var(--newsletter-text-color);
    opacity: 0.65;
  }

  #shopify-section-{{ section.id }} .newsletter-section__input:focus {
    border-color: var(--newsletter-text-color);
    box-shadow: inset 0 0 0 1px var(--newsletter-text-color);
  }

  #shopify-section-{{ section.id }} .newsletter-section__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1.50rem;
    border: 1px solid var(--newsletter-button-background);
    border-radius: 0;
    background-color: var(--newsletter-button-background);
    color: var(--newsletter-button-text);
    font-family: inherit;
    font-size: 1.35rem;
    font-weight: 400;
    width: 100%;
    line-height: 1.4;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  #shopify-section-{{ section.id }} .newsletter-section__button:hover {
    background-color: var(--newsletter-button-text);
    color: var(--newsletter-button-background);
  }

  #shopify-section-{{ section.id }} .newsletter-section__message {
    margin: 0 0 1rem;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  #shopify-section-{{ section.id }} .newsletter-section__message--success {
    color: var(--newsletter-text-color);
  }

  #shopify-section-{{ section.id }} .newsletter-section__message--error {
    color: var(--newsletter-text-color);
  }


  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .newsletter-section__content {
      grid-template-columns: minmax(18rem, 0.8fr) minmax(20rem, 1.2fr);
      column-gap: 5rem;
    }


    #shopify-section-{{ section.id }} .newsletter-section__form-fields {
      flex-direction: row;
      align-items: stretch;
    }

    #shopify-section-{{ section.id }} .newsletter-section__button {
      width: 50%;
    }
  }

  @media screen and (min-width: 1024px) {
    #shopify-section-{{ section.id }} .newsletter-section {
      min-height: 50vh;
    }


    #shopify-section-{{ section.id }} .newsletter-section__content {
      grid-template-columns: 1fr 1.35fr;
      column-gap: 8rem;
    }


    #shopify-section-{{ section.id }} .newsletter-section__heading {
      line-height: 1.05;
    }
  }
</style>

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "class": "section-newsletter",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "range",
      "id": "padding_block",
      "label": "Block padding",
      "min": 32,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 160
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Subscribe Our Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_form",
      "label": "Show newsletter form",
      "default": true
    },

    {
      "type": "header",
      "content": "Form"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email label",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Placeholder",
      "default": "Your e-mail address here"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thank you for subscribing!"
    },

    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "input_background_color",
      "label": "Input background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "input_border_color",
      "label": "Input border",
      "default": "#1B1B1B"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "Button background",
      "default": "#22272B"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Newsletter",
      "category": "Custom sections"
    }
  ]
}
{% endschema %}
