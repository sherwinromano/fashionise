{% comment %}
  Custom Footer
  Dawn-compatible custom footer section.

  Features:
  - Responsive mobile-first layout
  - Dynamic Shopify navigation menus
  - Dynamic colors
  - Dynamic spacing
  - Semantic HTML
  - BEM-style class naming
  - Shopify section ID on root element
{% endcomment %}

<footer
  id="shopify-section-{{ section.id }}"
  class="custom-footer"
  style="
    --custom-footer-background: {{ section.settings.background_color }};
    --custom-footer-text-color: {{ section.settings.text_color }};
    --custom-footer-heading-color: {{ section.settings.heading_color }};
    --custom-footer-link-color: {{ section.settings.link_color }};
    --custom-footer-padding-top: {{ section.settings.padding_top }}px;
    --custom-footer-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="custom-footer__container page-width">
    <div class="custom-footer__grid">
      {%- comment -%}
        ==========================================
        Brand / Description
        ==========================================
      {%- endcomment -%}

      {%- if section.settings.brand_title != blank or section.settings.brand_description != blank -%}
        <div class="custom-footer__brand">
          {%- if section.settings.brand_title != blank -%}
            <h2 class="custom-footer__brand-title">
              {{ section.settings.brand_title | escape }}
            </h2>
          {%- endif -%}

          {%- if section.settings.brand_description != blank -%}
            <div class="custom-footer__description rte">
              {{ section.settings.brand_description }}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- comment -%}
        ==========================================
        Footer Navigation Blocks
        ==========================================
      {%- endcomment -%}

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            {%- assign footer_menu = block.settings.menu -%}

            {%- if block.settings.heading != blank or footer_menu != blank -%}
              <nav
                class="custom-footer__menu"
                aria-label="{{ block.settings.heading | default: 'Footer navigation' | escape }}"
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.heading != blank -%}
                  <h2 class="custom-footer__menu-title">
                    {{ block.settings.heading | escape }}
                  </h2>
                {%- endif -%}

                {%- if footer_menu != blank and footer_menu.links.size > 0 -%}
                  <ul
                    class="custom-footer__menu-list"
                    role="list"
                  >
                    {%- for link in footer_menu.links -%}
                      <li class="custom-footer__menu-item">
                        <a
                          href="{{ link.url }}"
                          class="custom-footer__menu-link"
                          {% if link.current %}
                            aria-current="page"
                          {% endif %}
                        >
                          {{ link.title | escape }}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </nav>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</footer>

<style>
  /*
   * ==========================================
   * Custom Footer
   * ==========================================
   */

  #shopify-section-{{ section.id }} .custom-footer {
    width: 100%;
    background-color: var(--custom-footer-background);
    color: var(--custom-footer-text-color);
    padding-top: var(--custom-footer-padding-top);
    padding-bottom: var(--custom-footer-padding-bottom);
  }


  /*
   * ==========================================
   * Container
   * ==========================================
   */

  #shopify-section-{{ section.id }} .custom-footer__container {
    width: 100%;
  }


  /*
   * ==========================================
   * Grid
   * ==========================================
   */

  #shopify-section-{{ section.id }} .custom-footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }


  /*
   * ==========================================
   * Brand
   * ==========================================
   */


  #shopify-section-{{ section.id }} .custom-footer__brand-title {
    margin: 0 0 1.25rem;
    color: var(--custom-footer-heading-color);
    font-size: clamp(2rem, 5vw, 2.5rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: 0.02em;
  }


  /*
   * ==========================================
   * Description
   * ==========================================
   */

  #shopify-section-{{ section.id }} .custom-footer__description {
    margin: 0;
    color: var(--custom-footer-text-color);
    font-family: var(--font-heading-family);
    font-size: 1.50rem;
    line-height: 1.55;
  }

  #shopify-section-{{ section.id }} .custom-footer__description p {
    margin: 0;
  }


  /*
   * ==========================================
   * Navigation
   * ==========================================
   */

  #shopify-section-{{ section.id }} .custom-footer__menu {
    min-width: 0;
  }


  /*
   * ==========================================
   * Navigation Heading
   * ==========================================
   */

  #shopify-section-{{ section.id }} .custom-footer__menu-title {
    margin: 0 0 1.5rem;
    color: var(--custom-footer-heading-color);
    font-size: 1.50rem;
    font-weight: 500;
    line-height: 1.3;
    text-transform: uppercase;
  }


  /*
   * ==========================================
   * Navigation List
   * ==========================================
   */

  #shopify-section-{{ section.id }} .custom-footer__menu-list {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }


  /*
   * ==========================================
   * Navigation Item
   * ==========================================
   */

  #shopify-section-{{ section.id }} .custom-footer__menu-item {
    margin: 0;
    padding: 0;
  }


  /*
   * ==========================================
   * Navigation Link
   * ==========================================
   */

  #shopify-section-{{ section.id }} .custom-footer__menu-link {
    display: inline-block;
    color: var(--custom-footer-link-color);
    font-size: 12px;
    text-transform: uppercase;
    text-decoration: none;

    transition: opacity 0.2s ease;
  }

  #shopify-section-{{ section.id }} .custom-footer__menu-link:hover {
    opacity: 0.65;
  }

  #shopify-section-{{ section.id }} .custom-footer__menu-link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }


  /*
   * ==========================================
   * Tablet - 768px
   * ==========================================
   */

  @media screen and (min-width: 768px) {

    #shopify-section-{{ section.id }} .custom-footer__grid {
      grid-template-columns: 1.4fr 1fr 1fr;
      column-gap: 4rem;
      align-items: start;
    }

  }


  /*
   * ==========================================
   * Large Desktop - 1024px
   * ==========================================
   */

  @media screen and (min-width: 1024px) {

    #shopify-section-{{ section.id }} .custom-footer__grid {
      grid-template-columns: 1.5fr 1fr 1fr;
      column-gap: 7rem;
    }


    #shopify-section-{{ section.id }} .custom-footer__brand {
      max-width: 24rem;
    }


    #shopify-section-{{ section.id }} .custom-footer__brand-title {
      margin-bottom: 1.4rem;
      font-size: 2.5rem;
    }


    #shopify-section-{{ section.id }} .custom-footer__description {
      max-width: 25rem;

    }

  }
</style>

{% schema %}
{
  "name": "Footer",
  "tag": "footer",
  "class": "section-custom-footer",
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "text",
      "id": "brand_title",
      "label": "Brand title",
      "default": "FASHIONISE"
    },
    {
      "type": "richtext",
      "id": "brand_description",
      "label": "Brand description",
      "default": "<p>Vel non nibh vestibulum massa ullamcorper. Bibendum ultricies venenatis, id id sed mass commodo eros duis ut cras neque.</p>"
    },

    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#1B1B1B"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link color",
      "default": "#FFFFFF"
    },

    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 32,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 32,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Quick Links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "category": "Custom sections",
      "blocks": [
        {
          "type": "menu",
          "settings": {
            "heading": "Quick Links",
            "menu": "main-menu"
          }
        },
        {
          "type": "menu",
          "settings": {
            "heading": "Categories"
          }
        }
      ]
    }
  ]
}
{% endschema %}
